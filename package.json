{
  "name": "claude-toolbelt",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Always-on-top macOS edge widget listing Claude Code skills, plugins, commands and agents, with search and copy-to-clipboard prompt preparation.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "package": "electron-packager . Toolbelt --platform=darwin --out=dist --overwrite --ignore=\"tests|dist|docs|playwright.config.mjs|test-results|scripts\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.62.1",
    "electron": "^43.4.0",
    "playwright": "^1.62.1",
    "vitest": "^4.1.10"
  }
}
